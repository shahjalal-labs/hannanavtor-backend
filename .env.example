PORT=4000
NODE_ENV=development
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/hannanavtor?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret
EXPIRES_IN=15d

# Agora RTC
AGORA_APP_ID=your_agora_app_id
